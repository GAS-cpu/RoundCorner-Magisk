#!/sbin/sh
##########################################################################################
# 屏幕圆角 Magisk 模块 Installer (Magisk 25.0)
##########################################################################################

umask 022

OUTFD=$2
ZIPFILE=$3

ui_print() {
  if $BOOTMODE; then
    echo "$1"
  else
    echo -n -e "ui_print $1\n" >> /proc/self/fd/$OUTFD
    echo -n -e "ui_print\n" >> /proc/self/fd/$OUTFD
  fi
}

require_new_magisk() {
  ui_print "*******************************"
  ui_print " 请安装 Magisk v20.4 或更高版本 "
  ui_print "*******************************"
  exit 1
}

# 检测 Magisk 环境
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
elif [ -f /data/adb/magisk/util_functions ]; then
  . /data/adb/magisk/util_functions
else
  require_new_magisk
fi

ui_print "*******************************"
ui_print "     屏幕圆角 (Round Corner)   "
ui_print "        v1.0 by Shizuku        "
ui_print "*******************************"

# 安装模块
install_module

ui_print "- 安装完成，重启后生效"
ui_print "- 如需调整圆角大小，修改模块内 RoundCorner.apk 的 CORNER_RADIUS_DP"

exit 0
